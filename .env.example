# Copy this file to .env (make setup does it for you) and edit the copy.
# .env is git-ignored. Real environment variables always override it.

# ── 1. Mode ──────────────────────────────────────────────────────────────────
# MOCK=1 replays recorded model replies: free, deterministic, no keys needed.
# MOCK=0 calls a real model with the provider below.
MOCK=1

# ── 2. Live runs with the Claude API (simplest) ──────────────────────────────
# Set MOCK=0 above and paste your key from https://console.anthropic.com/
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── 3. Or live runs on Amazon Bedrock ────────────────────────────────────────
# Set LLM_PROVIDER=bedrock. Credentials come from your normal AWS setup
# (aws login, an SSO profile, or an attached role) -- never paste access keys here.
# AWS_PROFILE=
# AWS_REGION=us-east-1
# BEDROCK_MODEL=            # empty: use the first model your account can call

# ── Optional tuning ──────────────────────────────────────────────────────────
# LLM_MAX_TOKENS=8000       # per model call
# PROMPT_CACHE=1            # cache system prompts and tool schemas between calls
# MAX_ROUNDS=3              # planner investigation rounds before it must conclude
# MAX_QUESTIONS=2           # parallel investigators per round
# SCENARIO_DIR=scenarios/inventory-migration-lock

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
